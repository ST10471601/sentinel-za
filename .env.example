# Copy to .env and adjust. Never commit .env.
# Every setting is optional; these are the defaults. See src/sentinel/core/config.py.

# Root folder for generated data, Parquet files and local databases
SENTINEL_DATA_DIR=data

# Random seed so simulations are reproducible
SENTINEL_SEED=42

# Event broker: "local" (SQLite event log) or "kafka" (used in CI)
SENTINEL_BROKER=local
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Operational database (SQLite locally, Postgres in CI)
SENTINEL_DB_URL=sqlite:///data/operational.db

# Logging: DEBUG | INFO | WARNING | ERROR, and "text" or "json"
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_FORMAT=text
